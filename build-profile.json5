{
  "app": {
    // 签名配置：开源仓库不含真实签名凭据。
    // 本地构建请用 DevEco Studio 重新配置（File → Project Structure → Signing Configs）
    // 或替换下方 certpath / keyPassword / profile / storeFile / storePassword 为你的签名信息。
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "E:/p12/yssg_release.p12",
          "storePassword": "00000018AA437F020B80A53105BC31173A02B7731DB829DDC8ED20266F399936F897ABF27F211B41",
          "keyAlias": "YSSG",
          "keyPassword": "0000001813D24E7A1E7105A9732A93B08230CF6B7C88D9CDDF4FAF041275E70B2CBD35140D033438",
          "signAlg": "SHA256withECDSA",
          "profile": "E:/p12/yssg_release_profileRelease.p7b",
          "certpath": "E:/p12/yssg_release.cer"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        },
        "targetSdkVersion": "26.0.0"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
  ]
}
